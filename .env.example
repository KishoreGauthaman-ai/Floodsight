# FloodSight credentials template. Copy to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# Copernicus Data Space account (required for product downloads)
# Register at https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

# Optional: situation-report assistant. Without it, reports come from templates only.
ANTHROPIC_API_KEY=

# Optional: path to ESA SNAP's gpt executable (fallback radar processing)
SNAP_GPT_PATH=

# Optional: override the default data/ directory location
FLOODSIGHT_DATA_DIR=

EMSR_PORTAL_USERNAME=
EMSR_PORTAL_PASSWORD=
